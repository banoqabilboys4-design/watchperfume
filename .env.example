# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE DATABASE (PostgreSQL)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-or-anon-key"

# ADMIN CREDENTIALS
ADMIN_PASSWORD="aroyal2026"

# REAL ORDER EMAIL NOTIFICATIONS (Destination recipient for all orders)
NOTIFICATION_EMAIL="wahab.naseem6040@gmail.com"

# TRANSACTIONAL EMAIL PROVIDER (Set Resend, SendGrid, or SMTP for real email delivery)
# Option A: Resend (Recommended - get key at https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="A.royal Orders <onboarding@resend.dev>"

# Option B: SendGrid (Alternative - get key at https://sendgrid.com)
SENDGRID_API_KEY=""

# Option C: Direct SMTP / Gmail App Password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
